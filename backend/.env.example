# Neon via Vercel: use a POSTGRES_PRISMA_URL (pooled) aqui
DATABASE_URL="postgresql://user:password@host-pooler:5432/varzealeague?sslmode=require&pgbouncer=true"
# Neon via Vercel: use a POSTGRES_URL_NON_POOLING (direta) aqui — só é usada pelo Prisma Migrate
DIRECT_URL="postgresql://user:password@host:5432/varzealeague?sslmode=require"
JWT_SECRET="troque-este-valor-por-um-segredo-forte"
PORT=3333
